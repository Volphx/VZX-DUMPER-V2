<Window x:Class="Il2CppDumper_ImGuiStyle.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Il2CppDumper_ImGuiStyle"
 Title="VZX Dumper" Width="920" Height="680" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SharedControls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border x:Name="ApplicationSurface" Background="#090909" BorderBrush="#303030" BorderThickness="1" CornerRadius="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <Border x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" BorderBrush="#212121" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <DockPanel Margin="16,0,10,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnMinimize" Style="{StaticResource WindowButton}" Click="BtnMinimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"><Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" SnapsToDevicePixels="True"/></Button><Button x:Name="BtnClose" Style="{StaticResource WindowButton}" Click="BtnClose_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" Margin="3,0,0,0"><Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="9" Height="9" SnapsToDevicePixels="True"/></Button></StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" Background="#252525" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="{}{ }" FontFamily="Consolas" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="VZX Dumper" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="ANÁLISE IL2CPP" Foreground="#676767" FontSize="9" Margin="13,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1" Margin="16,12,16,10"><TabControl x:Name="MainTabs">
    <TabItem Header="Descompilação"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="147"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Captura ADB" Style="{StaticResource SectionTitle}"/><TextBlock Text="Opcional" Foreground="#777777" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Pacote do aplicativo" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/><TextBox x:Name="TxtAdbPackage" Text="com.dts.freefireth" Style="{StaticResource V0Input}"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Porta" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/><TextBox x:Name="TxtAdbPort" Text="5555" Style="{StaticResource V0Input}"/></StackPanel>
      <Button x:Name="BtnAdbExtract" Grid.Column="3" Content="Capturar arquivos" VerticalAlignment="Bottom" Style="{StaticResource V0Btn}" Click="BtnAdbExtract_Click"/>
     </Grid></Border>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
      <DockPanel Margin="0,0,0,10"><TextBlock Text="Arquivos de entrada" Style="{StaticResource SectionTitle}"/><TextBlock Text="Binário e metadados da mesma versão" Foreground="#777777" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock Text="Biblioteca ELF" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSoPath" Grid.Column="1" Style="{StaticResource V0Input}" ToolTip="libil2cpp.so ou dump de memória"/><Button x:Name="BtnBrowseSo" Grid.Column="2" Content="Procurar" Style="{StaticResource V0Btn}" Margin="8,0,0,0" Click="BtnBrowseSo_Click"/></Grid>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock Text="Metadados" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtMetaPath" Grid.Column="1" Style="{StaticResource V0Input}" ToolTip="global-metadata.dat"/><Button x:Name="BtnBrowseMeta" Grid.Column="2" Content="Procurar" Style="{StaticResource V0Btn}" Margin="8,0,0,0" Click="BtnBrowseMeta_Click"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock Text="Pasta de saída" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtOutputDir" Grid.Column="1" Style="{StaticResource V0Input}"/><Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Abrir" Margin="8,0,0,0" Style="{StaticResource V0Btn}" Click="BtnOpenFolder_Click"/><TextBlock Grid.Column="3" Text="Base (VA)" HorizontalAlignment="Center" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtBaseAddr" Grid.Column="4" Style="{StaticResource V0Input}" ToolTip="Opcional. Endereço-base do dump de memória."/></Grid>
     </StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}"/><TextBlock Text="Acompanhe as etapas da operação" Foreground="#777777" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="TxtMiniLog" Grid.Row="1" Background="Transparent" Foreground="#929292" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CaretBrush="Transparent"/></Grid></Border>
     <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="PrgBar" Height="2" Margin="0,0,0,8" Background="#171717" Foreground="#DEDEDE" BorderThickness="0"/><DockPanel Grid.Row="1"><Button x:Name="BtnStartDump" Content="Gerar dump" DockPanel.Dock="Right" Width="190" Height="36" Style="{StaticResource PrimaryButton}" Click="BtnStartDump_Click"/><TextBlock Text="Os arquivos serão salvos na pasta indicada." Foreground="#777777" FontSize="11" VerticalAlignment="Center"/></DockPanel></Grid>
    </Grid></TabItem>
    <TabItem x:Name="OffsetsTab" Header="Offsets + RVA"><local:OffsetSearchView x:Name="OffsetsView"/></TabItem>
    <TabItem Header="Configurações"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,6,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="Conteúdo do dump" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha quais informações serão geradas." Foreground="#777777" FontSize="11" Margin="0,5,0,12"/>
      <CheckBox x:Name="ChkDumpMethod" Content="Métodos" IsChecked="True" ToolTip="DumpMethod"/><CheckBox x:Name="ChkDumpField" Content="Campos" IsChecked="True" ToolTip="DumpField"/><CheckBox x:Name="ChkDumpProperty" Content="Propriedades" IsChecked="True" ToolTip="DumpProperty"/><CheckBox x:Name="ChkDumpAttribute" Content="Atributos" IsChecked="True" ToolTip="DumpAttribute"/><CheckBox x:Name="ChkDumpFieldOffset" Content="Offsets dos campos" IsChecked="True"/><CheckBox x:Name="ChkDumpMethodOffset" Content="RVAs e offsets dos métodos" IsChecked="True"/><CheckBox x:Name="ChkDumpTypeDefIndex" Content="Índices de definição dos tipos" IsChecked="True"/>
     </StackPanel></Border>
     <StackPanel Grid.Column="1" Margin="6,0,0,0"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Exportação" Style="{StaticResource SectionTitle}"/><TextBlock Text="Arquivos auxiliares para análise." Foreground="#777777" FontSize="11" Margin="0,5,0,12"/><CheckBox x:Name="ChkGenerateDummyDll" Content="Dummy DLLs para dnSpy / ILSpy" IsChecked="True"/><CheckBox x:Name="ChkDummyDllAddToken" Content="Tokens nas Dummy DLLs" IsChecked="True"/><CheckBox x:Name="ChkGenerateStruct" Content="script.json e il2cpp.h" IsChecked="True"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Opções avançadas" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="ChkForceDump" Content="Forçar modo de dump de memória" IsChecked="False" Margin="0,14,0,7"/><CheckBox x:Name="ChkDumpOnlyAssemblyCSharp" Content="Somente Assembly-CSharp.dll" IsChecked="False"/></StackPanel></Border></StackPanel>
    </Grid></ScrollViewer></TabItem>
    <TabItem Header="Logs"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="BtnClearLogs" Content="Limpar histórico" DockPanel.Dock="Right" Style="{StaticResource V0Btn}" Click="BtnClearLogs_Click"/><StackPanel><TextBlock Text="Histórico da sessão" Style="{StaticResource SectionTitle}"/><TextBlock Text="Mensagens completas de captura, descompilação e análise." Foreground="#777777" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel><TextBox x:Name="TxtFullLog" Grid.Row="1" Background="Transparent" Foreground="#A3A3A3" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CaretBrush="Transparent"/></Grid></Border></TabItem>
   </TabControl></Grid>
   <Border Grid.Row="2" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0"><DockPanel Margin="16,0"><TextBlock Text="WINDOWS X64" FontSize="9" Foreground="#696969" VerticalAlignment="Center"/><TextBlock Text="ARMv7 / ARM64  ·  Análise local" FontSize="10" Foreground="#777777" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
                <Border Background="#0a0a0a" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" 
                        Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.9" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Modal Header -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Icon Badge -->
                                <Border x:Name="ModalIconBd" Background="#166534" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                                    <TextBlock x:Name="ModalIconTxt" Text="✓" Foreground="#4ade80" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ModalTitleTxt" Text="Descompilação Concluída" Foreground="#ffffff" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource WindowButton}" Click="BtnModalClose_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </DockPanel>

                        <!-- Modal Description -->
                        <TextBlock x:Name="ModalMsgTxt" Text="Os arquivos de dump e Dummy DLLs foram gerados com sucesso!" 
                                   Foreground="#a3a3a3" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Path Box -->
                        <Border x:Name="ModalPathBd" Background="#050505" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBlock x:Name="ModalPathTxt" Text="C:\Dumps" Foreground="#BDBDBD" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Modal Actions -->
                        <DockPanel LastChildFill="False">
                            <Button x:Name="BtnModalOpenFolder" Content="Abrir Pasta dos Dumps" Style="{StaticResource V0Btn}" 
                                    DockPanel.Dock="Left" Width="170" Height="34" Click="BtnModalOpenFolder_Click"/>
                            <Button Content="Fechar" DockPanel.Dock="Right" Width="90" Height="34"
                                    Background="#ffffff" Foreground="#000000" FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0" Click="BtnModalClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
  </Grid>
 </Border>
</Window>
