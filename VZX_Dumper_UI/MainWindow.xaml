<Window x:Class="Il2CppDumper_ImGuiStyle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VZX Dumper v2.0" 
        Height="680" Width="920" 
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#ededed"
        FontFamily="Segoe UI, -apple-system, system-ui, sans-serif">

    <Window.Resources>
        <!-- V0 Subtle Scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#262626" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- V0 Pill Tabs Container -->
                            <Border Grid.Row="0" Background="#0a0a0a" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 Pill TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="2,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#262626"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBd" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="#d4d4d4"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 Single Line Input TextBox (Explicitly with x:Key to NOT affect MultiLine Console) -->
        <Style x:Key="V0Input" TargetType="TextBox">
            <Setter Property="Background" Value="#0a0a0a"/>
            <Setter Property="Foreground" Value="#ededed"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#ffffff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#404040"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#ffffff"/>
                                <Setter TargetName="Bd" Property="Background" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 Secondary Button -->
        <Style x:Key="V0Btn" TargetType="Button">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#ededed"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#404040"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0f0f0f"/>
                                <Setter Property="Foreground" Value="#525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 System Window Buttons -->
        <Style x:Key="SysBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SysCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e11d48"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- V0 Rounded CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="Box" Width="17" Height="17" CornerRadius="5" Background="#0a0a0a" BorderBrush="#262626" BorderThickness="1" Margin="0,0,10,0">
                                <Path Name="CheckMark" Data="M 3,7 L 6,11 L 13,4" Stroke="#000000" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#ffffff"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#737373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame (Authentic V0 Obsidian Dark with 14px Rounded Corners & Soft DropShadow) -->
    <Border Background="#000000" BorderBrush="#262626" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar -->
                <RowDefinition Height="40"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. V0 CLEAN TITLE BAR (Rounded Top) -->
            <Border Grid.Row="0" Background="#050505" BorderBrush="#1f1f1f" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True" Margin="14,0,10,0">
                    <!-- Window Min / Close Controls -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource SysBtn}" Click="BtnMinimize_Click" ToolTip="Minimizar"/>
                        <Button x:Name="BtnClose" Content="✕" Style="{StaticResource SysCloseBtn}" Click="BtnClose_Click" ToolTip="Fechar" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Title & V0 Triangle Accent -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Polygon Points="0,12 6,2 12,12" Fill="#ffffff" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VZX Dumper" Foreground="#ffffff" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Background="#1f1f1f" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.0" Foreground="#a3a3a3" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="— ELF64 &amp; ELF32 Decompiler" Foreground="#525252" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. MAIN APPLICATION CONTENT -->
            <Grid Grid.Row="1" Margin="18,14,18,18">
                <TabControl>
                    <!-- TAB 1: DESCOMPILAÇÃO -->
                    <TabItem Header="Descompilação">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <!-- ADB Card -->
                                <RowDefinition Height="Auto"/>
                                <!-- File Form Card -->
                                <RowDefinition Height="Auto"/>
                                <!-- Console / Output Window -->
                                <RowDefinition Height="*"/>
                                <!-- Progress Bar + Action Button -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SEÇÃO 1: ADB -->
                            <Border Grid.Row="0" Background="#0a0a0a" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pacote -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Pacote do Aplicativo (Package Name):" Foreground="#a3a3a3" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtAdbPackage" Text="com.dts.freefireth" Style="{StaticResource V0Input}"/>
                                    </StackPanel>

                                    <!-- Porta ADB -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Porta ADB:" Foreground="#a3a3a3" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtAdbPort" Text="5555" Style="{StaticResource V0Input}"/>
                                    </StackPanel>

                                    <!-- Botão de Extração ADB -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnAdbExtract" Content="Extrair da Memória" Style="{StaticResource V0Btn}" Click="BtnAdbExtract_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SEÇÃO 2: FORMULÁRIO DE ARQUIVOS -->
                            <Border Grid.Row="1" Background="#0a0a0a" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Linha 1: Binário SO -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Binário ELF (.so):" Foreground="#d4d4d4" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtSoPath" Grid.Column="1" Style="{StaticResource V0Input}"/>
                                        <Button x:Name="BtnBrowseSo" Grid.Column="2" Content="Procurar" Margin="8,0,0,0" Style="{StaticResource V0Btn}" Click="BtnBrowseSo_Click"/>
                                    </Grid>

                                    <!-- Linha 2: Metadata -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Metadados (.dat):" Foreground="#d4d4d4" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMetaPath" Grid.Column="1" Style="{StaticResource V0Input}"/>
                                        <Button x:Name="BtnBrowseMeta" Grid.Column="2" Content="Procurar" Margin="8,0,0,0" Style="{StaticResource V0Btn}" Click="BtnBrowseMeta_Click"/>
                                    </Grid>

                                    <!-- Linha 3: Pasta de Saída & Endereço Base -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Pasta de Saída:" Foreground="#d4d4d4" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtOutputDir" Grid.Column="1" Style="{StaticResource V0Input}"/>
                                        <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Abrir" Margin="8,0,0,0" Style="{StaticResource V0Btn}" Click="BtnOpenFolder_Click"/>
                                        <TextBlock Grid.Column="3" Text="Endereço Base:" Foreground="#d4d4d4" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtBaseAddr" Grid.Column="4" Style="{StaticResource V0Input}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SEÇÃO 3: CONSOLE / TERMINAL (100% Corrigido com TextBox Multiline Nativo) -->
                            <Border Grid.Row="2" Background="#050505" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                                <TextBox x:Name="TxtMiniLog" 
                                         Background="Transparent" 
                                         Foreground="#a3a3a3" 
                                         BorderThickness="0" 
                                         FontFamily="Consolas, 'Cascadia Code', monospace" 
                                         FontSize="11.5" 
                                         Padding="12,10"
                                         IsReadOnly="True" 
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         CaretBrush="Transparent"/>
                            </Border>

                            <!-- SEÇÃO 4: PROGRESSO & BOTÃO PRIMÁRIO V0 -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ProgressBar x:Name="PrgBar" Grid.Row="0" Height="2" Margin="0,0,0,10" Background="#171717" Foreground="#ffffff" BorderThickness="0"/>

                                <!-- V0 Signature High-Contrast Action Button -->
                                <Button x:Name="BtnStartDump" Grid.Row="1" Content="Descompilar Arquivos" 
                                        Background="#ffffff" Foreground="#000000" FontWeight="Bold" FontSize="13" 
                                        Height="40" Cursor="Hand" BorderThickness="0" Click="BtnStartDump_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#e5e5e5"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#cccccc"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1f1f1f"/>
                                                    <Setter Property="Foreground" Value="#525252"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: CONFIGURAÇÕES -->
                    <TabItem Header="Configurações">
                        <Border Background="#0a0a0a" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,2,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Descompilação &amp; Estrutura:" Foreground="#ffffff" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkDumpMethod" Content="Gerar Métodos (DumpMethod)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpField" Content="Gerar Campos (DumpField)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpProperty" Content="Gerar Propriedades (DumpProperty)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpAttribute" Content="Gerar Atributos (DumpAttribute)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpFieldOffset" Content="Gerar Offsets de Campos (DumpFieldOffset)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpMethodOffset" Content="Gerar Offsets e RVAs de Métodos" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDumpTypeDefIndex" Content="Incluir TypeDefIndex" IsChecked="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Exportação de Assemblies &amp; Análise:" Foreground="#ffffff" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkGenerateDummyDll" Content="Gerar Dummy DLLs completas (dnSpy / ILSpy)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDummyDllAddToken" Content="Adicionar Tokens nas Dummy DLLs" IsChecked="True"/>
                                        <CheckBox x:Name="ChkGenerateStruct" Content="Gerar script.json &amp; il2cpp.h (IDA / Ghidra)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkForceDump" Content="Forçar Modo Dump de Memória (ForceDump)" IsChecked="False"/>
                                        <CheckBox x:Name="ChkDumpOnlyAssemblyCSharp" Content="Exportar apenas Assembly-CSharp.dll" IsChecked="False"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: LOGS COMPLETOS -->
                    <TabItem Header="Logs Detalhados">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button x:Name="BtnClearLogs" Content="Limpar Logs" Width="100" Style="{StaticResource V0Btn}" Click="BtnClearLogs_Click"/>
                                <TextBlock Text="Histórico Completo de Execução" Foreground="#737373" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#050505" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="10">
                                <TextBox x:Name="TxtFullLog" 
                                         Background="Transparent" 
                                         Foreground="#a3a3a3" 
                                         BorderThickness="0" 
                                         FontFamily="Consolas, 'Cascadia Code', monospace" 
                                         FontSize="12" 
                                         Padding="14"
                                         IsReadOnly="True" 
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         CaretBrush="Transparent"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- 3. V0 LUXURY DARK MODAL DIALOG (Substitui a MessageBox feia do Windows) -->
            <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
                <Border Background="#0a0a0a" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" 
                        Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.9" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Modal Header -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Icon Badge -->
                                <Border x:Name="ModalIconBd" Background="#166534" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                                    <TextBlock x:Name="ModalIconTxt" Text="✓" Foreground="#4ade80" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ModalTitleTxt" Text="Descompilação Concluída" Foreground="#ffffff" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource SysCloseBtn}" Click="BtnModalClose_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </DockPanel>

                        <!-- Modal Description -->
                        <TextBlock x:Name="ModalMsgTxt" Text="Os arquivos de dump e Dummy DLLs foram gerados com sucesso!" 
                                   Foreground="#a3a3a3" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Path Box -->
                        <Border x:Name="ModalPathBd" Background="#050505" BorderBrush="#1f1f1f" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBlock x:Name="ModalPathTxt" Text="C:\Dumps" Foreground="#38bdf8" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Modal Actions -->
                        <DockPanel LastChildFill="False">
                            <Button x:Name="BtnModalOpenFolder" Content="Abrir Pasta dos Dumps" Style="{StaticResource V0Btn}" 
                                    DockPanel.Dock="Left" Width="170" Height="34" Click="BtnModalOpenFolder_Click"/>
                            <Button Content="Fechar" DockPanel.Dock="Right" Width="90" Height="34"
                                    Background="#ffffff" Foreground="#000000" FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0" Click="BtnModalClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>