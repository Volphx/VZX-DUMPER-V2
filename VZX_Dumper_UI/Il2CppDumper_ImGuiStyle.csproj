<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Il2CppDumper_Core\Il2CppDumper\Il2CppDumper.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <OffsetRvaHeaders Include="Native\Core\*.hpp" />
    <OffsetRvaHeaders Include="Native\Live\*.hpp" />
    <EmbeddedResource Include="Native\bin\OffsetRvaEngine.dll" LogicalName="VZX.OffsetRvaEngine.dll" />
  </ItemGroup>
  <Target Name="BuildOffsetRvaEngine" BeforeTargets="PrepareForBuild"
          Inputs="Native\bridge.cpp;Native\build.cmd;@(OffsetRvaHeaders)"
          Outputs="$(MSBuildProjectDirectory)\Native\bin\OffsetRvaEngine.dll">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\build.cmd&quot;" />
  </Target>
</Project>
